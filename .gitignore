target

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
/bin/

# Claude Code settings. Personal state under .claude/ stays out of the repo, but
# settings.json and hooks/ are shared project config and have to be committed: a
# SessionStart hook only reaches a cloud session if it is on the default branch.
# See docs/headless-rendering.md.
.claude/*
!.claude/settings.json
!.claude/hooks/

# Render output is review evidence, not documentation. See docs/headless-rendering.md
docs/renders/

# Wrangler local cache, created if you run `wrangler` (e.g. to publish renders to your
# own object storage) with this repo as cwd. See docs/headless-rendering.md.
.wrangler/
