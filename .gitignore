target

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
/bin/

# Claude Code settings. Personal, machine-local config (settings.local.json, caches)
# stays out of the repo; the shared project config is committed, so every Claude Code
# on the web session picks up the SessionStart hook that provisions its container.
# Git cannot re-include a path whose parent directory is excluded, so ignore .claude's
# *contents* rather than .claude itself, then negate the two files we actually share.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/session-start.sh

# Render output is review evidence, not documentation. See docs/headless-rendering.md
docs/renders/

# Wrangler local cache, created if you run `wrangler` (e.g. to publish renders to your
# own object storage) with this repo as cwd. See docs/headless-rendering.md.
.wrangler/
